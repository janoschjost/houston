{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Houston",
  "version": "0.1.0",
  "identifier": "dev.janosch.houston",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Houston",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFOTIxOEJBMzE3NTk3MUYKUldRZmwzVXh1aGlTbmxMVXlsalQ1MGErcVoxSnk4MXVyZ0tNWDl4TVlGUzVXVVhsNm5Ya01pdFoK",
      "endpoints": ["https://github.com/janoschjost/houston/releases/latest/download/latest.json"]
    }
  }
}
